<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Required here, in main, not just in the debug and profile manifests
         Flutter ships. Those two exist only so the tooling can reach the Dart
         VM service; a release build merges neither, so without this line the
         shipped app would have no network access at all and every Firebase
         call would fail on a user's phone. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Voice chat. Guessers talk to each other over WebRTC while somebody
         draws; the drawer's microphone is never opened at all.

         RECORD_AUDIO is a runtime permission: flutter_webrtc asks for it the
         first time getUserMedia is called, which is the moment a player first
         becomes a guesser. Declining leaves the rest of the game working.

         MODIFY_AUDIO_SETTINGS is what lets the plugin put the call on the
         loudspeaker instead of the earpiece — a player is looking at the
         canvas, not holding the phone to their ear.

         BLUETOOTH_CONNECT covers routing to a paired headset on API 31 and
         above; BLUETOOTH is its pre-31 equivalent and is capped so newer
         devices do not ask for the legacy one. Neither is required for voice
         to work, only for it to follow a headset. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />

    <!-- The locality leaderboard. COARSE and not FINE, deliberately: the app
         asks the geocoder which town a fix is in and keeps the answer, so a
         city-block-sized fix is exactly as useful as a metre-accurate one and
         ACCESS_FINE_LOCATION would be asking for precision nothing reads.

         A runtime permission: geolocator prompts for it the first time a
         player taps "Use my location" on their profile or in Settings, and
         only after the app has explained what it is for. Declining leaves
         every other part of the game working and the town typeable by hand.

         There is deliberately no ACCESS_BACKGROUND_LOCATION: one fix is read
         per tap and never otherwise, so nothing here runs while the app is
         closed. geolocator does merge its own GeolocatorLocationService into
         the final manifest — it binds to it on attach, so it cannot be
         stripped — but that service only does work for a position stream
         with a foreground notification, which this app never starts. Nothing
         requests FOREGROUND_SERVICE either, so it could not run as one. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Push notifications.

         Required from API 33 (Android 13) onwards, where showing a
         notification is a runtime permission like the camera. Without this
         line the system prompt cannot be raised at all: the request silently
         resolves as denied, every notification is dropped, and nothing in the
         app or in logcat says why. On API 32 and below it is ignored and
         notifications work regardless.

         FirebaseMessaging.requestPermission() raises the prompt, once, from
         NotificationPermissionService. Declining leaves the whole game
         working — the tournament countdown is still on the screen — and only
         costs the nudge that would have reached a closed app. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- A phone without a microphone can still play: it draws, guesses and
         types, and simply hears nothing. Declared not-required so the app
         stays installable on such a device. -->
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <!-- Same reasoning for location hardware: a device that cannot place
         itself at all plays the whole game and types its town in. -->
    <uses-feature
        android:name="android.hardware.location"
        android:required="false" />

    <application
        android:label="Scribble &amp; Guess"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Which channel a push lands on when the server did not name one,
             and which icon the status bar draws.

             Both matter more than they look. Android silently ignores a
             channel id it has never been told about and delivers on the
             default channel at default importance — no heads-up, no sound on
             a locked phone — which to a player is indistinguishable from the
             notification never arriving. The id here matches the channel
             NotificationService creates at startup and the one the backend
             names on every send; all three must stay in step.

             The icon must be a monochrome drawable. Android tints it and
             discards every colour in it, so a launcher icon used here renders
             as a plain white square on API 21 and above. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="tournament_notifications" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_notification" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
