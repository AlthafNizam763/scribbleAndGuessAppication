<?xml version="1.0" encoding="utf-8"?>
<!-- The window the system shows while the Flutter engine boots.
     Both layers resolve per night mode: the colour through values-night, the
     mark through drawable-night-*dpi. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_logo" />
    </item>
</layer-list>
