# Scribble & Guess — example environment
#
# Copy to .env and fill in. The Flutter app reads its configuration from
# --dart-define (see README), so this file is primarily for the two backends
# and for assembling build commands.
#
# NEVER commit a filled-in .env, a service-account JSON, or a signing key.

# ---------------------------------------------------------------------------
# Game backend (scribbleAndGuessWeb)
# ---------------------------------------------------------------------------
# Run locally, the REST API and the Socket.IO endpoint are the same origin:
# `server.ts` serves both on one port, so API_BASE_URL alone is enough.
#
# Deployed, they are NOT the same origin. Socket.IO needs a process that stays
# alive to hold a websocket open, and the REST deployment is serverless — it
# starts a function per request and tears it down after. Pointed at it, the
# socket cannot connect, /api/health reports the socket as detached, and the
# app shows "No connection. Check your network and try again." even though
# guest sign-in succeeded. So the realtime server is deployed separately and
# named separately.
#
# Both addresses are baked into lib/app/app_config.dart, as
# `AppConfig.deployedBackendUrl` and `AppConfig.deployedRealtimeUrl`, and are
# the default for every flavor — a plain `flutter run` already talks to the
# deployment. These defines only exist to point a build somewhere else.
#
# Production:
# API_BASE_URL
# https://scribble-and-guess-web.vercel.app

# SOCKET_URL
# https://scribbleandguessweb.onrender.com
#
# Local backend, Android emulator:
#   flutter run --dart-define=API_BASE_URL=http://10.0.2.2:3000
# Local backend, desktop or web:
#   flutter run --dart-define=API_BASE_URL=http://localhost:3000
# Physical device: use the host machine's LAN IP and bind the backend to
# 0.0.0.0 (the HOST value in scribbleAndGuessWeb/.env.local).
#
# SOCKET_URL falls back to deployedRealtimeUrl, then to API_BASE_URL. The last
# fallback is correct for a local single-process backend and wrong against the
# serverless deployment; the app logs that case explicitly.
# DRAWING_SOCKET_URL is the older name for SOCKET_URL and still works.
# API_BASE_URL=
# SOCKET_URL=

# ---------------------------------------------------------------------------
# Flavor
# ---------------------------------------------------------------------------
# development | staging | production
#
# This no longer selects the backend — every flavor points at the deployment
# unless API_BASE_URL says otherwise. It still gates the Firebase emulator
# suite, analytics and Crashlytics.
FLAVOR=development

# ---------------------------------------------------------------------------
# Firebase client configuration
# ---------------------------------------------------------------------------
# Only needed until `flutterfire configure` generates lib/firebase_options.dart.
# These identify the project; they do not authorise anything. Access is decided
# by firestore.rules, storage.rules, App Check and the functions themselves.
FIREBASE_PROJECT_ID=scribble-and-guess-dev
FIREBASE_API_KEY=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_AUTH_DOMAIN=
FIREBASE_WEB_APP_ID=
FIREBASE_ANDROID_APP_ID=
FIREBASE_IOS_APP_ID=
FIREBASE_IOS_BUNDLE_ID=com.scribbleandguess.app

# App Check on web.
RECAPTCHA_SITE_KEY=

# ---------------------------------------------------------------------------
# Drawing relay (server/)
# ---------------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# "*" is fine for local work and for mobile clients. Set an explicit origin
# allowlist in production.
CORS_ORIGIN=*

# The relay authenticates every socket against Firebase and reads Firestore to
# find out who may draw, so it needs credentials of its own. Use ONE of:
#   GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
#   FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
GOOGLE_APPLICATION_CREDENTIALS=

# ---------------------------------------------------------------------------
# Local emulator suite
# ---------------------------------------------------------------------------
# Set these when running the relay or the seed script against the emulators.
# FIRESTORE_EMULATOR_HOST=localhost:8080
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# NOTE: the standalone drawing relay above is superseded. The Node backend in
# scribbleAndGuessWeb owns the whole game, strokes included, and the app points
# at it through API_BASE_URL at the top of this file.
